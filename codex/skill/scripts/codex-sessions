  const b = e.target.closest("button.cmd");
  if (!b) return;
  e.preventDefault(); e.stopPropagation();
  const text = b.dataset.c;
  const done = () => { const o = b.textContent; b.textContent = "copied ✓";
    setTimeout(() => b.textContent = o, 1400); };
  const fallback = () => {
    const ta = document.createElement("textarea"); ta.value = text;
    document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy"); done(); } catch (_) { prompt("Copy:", text); }
    ta.remove();
  };
  if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, fallback);
  else fallback();
