def cmd_page(args):
    rows = scan_library(days=None if args.all else args.days, deep=not args.fast)
    live = {w.get("session") for w in match_sessions(discover())}
    snap = load() or {"saved": []}
    arch = {r["session"] for r in snap["saved"] if r.get("archived")}
    remembered = {r["session"] for r in snap["saved"] if not r.get("archived")}
    for r in rows:
        r["state"] = ("open" if r["session"] in live
                      else "archived" if r["session"] in arch
                      else "remembered" if r["session"] in remembered
                      else "closed")
    out = os.path.expanduser(args.out)
    # a conversation that mentions </script> would otherwise end the script block
    blob = json.dumps(rows).replace("</", "<\\/")
    html = PAGE.replace("__DATA__", blob)
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    atomic_write(out, "<!doctype html><meta charset=utf-8>"
                 "<meta name=viewport content=\"width=device-width,initial-scale=1\">" + html)
    n = collections.Counter(r["state"] for r in rows)
    print("%d conversation(s) -> %s" % (len(rows), out))
    print("  " + ", ".join("%d %s" % (v, k) for k, v in n.most_common()))
    if args.open:
        sh(["open", out])
    return 0


def cmd_archive(args):
    """Mark windows you closed on purpose: remembered on the page, never reopened."""
    d = load()
    if not d:
        print("no snapshot yet — run: codex-sessions save")
        return 1
    running = {w.get("session") for w in match_sessions(discover())}
    hit = 0
    for r in d["saved"]:
        sid = r.get("session")
        if not sid:
            continue
        match = (args.gone and sid not in running) or any(
            t in r["cwd"] or sid.startswith(t) for t in args.what)
        if match and not r.get("archived"):
            if args.undo:
                continue
            r["archived"] = True
            r["live"] = False
            hit += 1
        elif match and args.undo:
            r.pop("archived", None)
            hit += 1
    if not hit:
        print("nothing matched")
        return 1
    write_snapshot(d["saved"])
    print("%s %d conversation(s)" % ("un-archived" if args.undo else "archived", hit))
    print("  they stay in `codex-sessions page`; `restore` will leave them closed")
    return 0


FOCUS_ITERM = """
tell application "iTerm2"
  repeat with w in windows
    try
      if (tty of first session of first tab of w) is "%s" then
        select w
        activate
        return "ok"
      end if
    end try
  end repeat
  return ""
end tell
"""

FOCUS_TERMINAL = """
tell application "Terminal"
  repeat with w in windows
    try
      if (tty of first tab of w) is "%s" then
        set index of w to 1
        activate
        return "ok"
      end if
    end try
  end repeat
  return ""
end tell
"""


def focus(tty, app):
    tmpl = FOCUS_ITERM if app == "iTerm2" else FOCUS_TERMINAL
    rc, out, err = osa(tmpl % tty)
    return rc == 0 and out == "ok"


def cmd_find(args):
    """Where is my <thing> session — and is it already open?"""
    q = " ".join(args.query).lower()
    if not q:
        print("give me something to look for, e.g. `codex-sessions find gloss`")
        return 1

    wins = {w.get("session"): w for w in match_sessions(discover()) if w.get("session")}
    geo = geometry()
    rows = scan_library(days=None if args.all else args.days, deep=True)
    snap = load() or {"saved": []}
    arch = {r["session"] for r in snap["saved"] if r.get("archived")}

    hits = []
    for r in rows:
        hay = " ".join([r["cwd"], r["first"], r["last"], r["branch"], r["session"]] +
                       [m["m"] for m in r.get("thread", [])]).lower()
        if q not in hay:
            continue
        r["open"] = r["session"] in wins
        r["archived"] = r["session"] in arch
        # a match in the directory name is what you usually mean by "my gloss session"
        r["score"] = (0 if r["open"] else 1, 0 if q in r["cwd"].lower() else 1, -r["mtime"])
        hits.append(r)
    hits.sort(key=lambda r: r["score"])

    if not hits:
        print("nothing matching %r in the last %s" % (q, "of time" if args.all else "%d days" % args.days))
        return 1

    if args.go:
        r = hits[0]
        if r["open"]:
            w = wins[r["session"]]
            app = geo.get(w["tty"], {}).get("term") or terminal_app()
            if focus(w["tty"], app):
                print("brought forward: %s" % r["cwd"])
                print("  %s" % (r["last"] or r["first"])[:110])
                return 0
            print("that window is open (%s, %s) but would not come forward" % (r["cwd"], w["tty"]))
            return 1
        row = {"cwd": r["cwd"], "session": r["session"]}
        term = terminal_app()
        if not term:
            print("neither iTerm2 nor Terminal is running")
            return 1
        ok, out = open_window(term, build_cmd(row), None)
        print(("reopened " if ok else "FAILED to reopen ") + r["cwd"])
        if not ok:
            print("  %s" % build_cmd(row))
        return 0 if ok else 1

    print("%d match(es) for %r:" % (len(hits), q))
    for r in hits[:args.limit]:
        mark = "OPEN " if r["open"] else "arch " if r["archived"] else "     "
        w = wins.get(r["session"])
        where = ""
        if w:
            b = geo.get(w["tty"], {}).get("bounds")
            where = "  [%s%s]" % (w["tty"].replace("/dev/", ""),
                                  ", at %d,%d" % (b[0], b[1]) if b else "")
        print("  %s%s%s" % (mark, r["cwd"], where))
        print("        %s" % (r["first"] or "(no prompt yet)")[:100])
        if r["last"] and r["last"] != r["first"]:
            print("        left off: %s" % r["last"][:100])
        if not r["open"]:
            print("        " + build_cmd(r))
    if len(hits) > args.limit:
        print("  ... and %d more" % (len(hits) - args.limit))
    if hits[0]["open"]:
        print("\n`codex-sessions find %s --go` brings that window forward" % q)
    else:
        print("\n`codex-sessions find %s --go` reopens the top match" % q)
    return 0


def cmd_doctor(args):
    wins = match_sessions(discover())
    geo = geometry()
    print("Desktop app threads are searchable, but app window layout is not managed. Unknown terminal sessions are never guessed.")
    print("terminal: %s" % (terminal_app() or "none running"))
    print("snapshot: %s%s" % (STATE, "" if os.path.exists(STATE) else "  (does not exist yet)"))
    print("history:  %d snapshot(s) in %s" % (len(history()), HISTDIR))
    print("%d Codex window(s) visible:" % len(wins))
    for w in wins:
        g = geo.get(w["tty"], {})
        print("  pid %-6d %-10s %-42s %s  %s"
              % (w["pid"], w["tty"].replace("/dev/", ""), w["cwd"],
                 (w.get("session") or "-")[:8], w.get("match")))
        if not g:
            print("         no window position — this window will come back unpositioned")
    guessed = [w for w in wins if w.get("match") == "mtime"]
    if guessed:
        print("\n%d window(s) matched only by 'most recently written transcript'. Those can come"
              "\nback on the wrong conversation. They become exact once restored (the session id"
              "\nthen sits on the command line)." % len(guessed))
    if WARNINGS:
        print("\n%d warning(s) above." % len(WARNINGS))
    return 0


PLIST_TMPL = '''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.codexsessions.snapshot</string>
  <key>ProgramArguments</key>
  <array><string>%s</string><string>save</string></array>
  <key>StartInterval</key><integer>%d</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>/tmp/codex-sessions.err</string>
</dict></plist>
'''


def cmd_install_auto(args):
    self = os.path.realpath(__file__)
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    with open(PLIST, "w") as fh:
        fh.write(PLIST_TMPL % (self, args.seconds))
    sh(["launchctl", "unload", PLIST])
    rc, _, err = sh(["launchctl", "load", PLIST])
    if rc != 0:
        print("launchctl load failed: %s" % err.strip())
        return 1
    print("auto-save installed: every %ds -> %s" % (args.seconds, STATE))
    print("  it merges, so a window that fails to reopen is not forgotten")
    return 0


ARRANGE_PLIST = os.path.join(USER_ROOT, "Library", "LaunchAgents", "dev.codexsessions.arrange.plist")

ARRANGE_TMPL = '''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.codexsessions.arrange</string>
  <key>ProgramArguments</key>
  <array>%s</array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/codex-sessions-arrange.err</string>
</dict></plist>
'''


def cmd_install_arrange(args):
    self = os.path.realpath(__file__)
    argv = [self, "arrange", args.mode, "--watch", "--every", str(args.every)]
    if args.cols:
        argv += ["--cols", str(args.cols)]
    if args.rect:
        argv += ["--rect", ",".join(str(x) for x in args.rect)]
    if args.busy_first:
        argv.append("--busy-first")
    body = "".join("<string>%s</string>" % a for a in argv)
    os.makedirs(os.path.dirname(ARRANGE_PLIST), exist_ok=True)
    with open(ARRANGE_PLIST, "w") as fh:
        fh.write(ARRANGE_TMPL % body)
    sh(["launchctl", "unload", ARRANGE_PLIST])
    rc, _, err = sh(["launchctl", "load", ARRANGE_PLIST])
    if rc != 0:
        print("launchctl load failed: %s" % err.strip())
        return 1
    print("auto-arrange installed: %s layout, applied whenever a window opens or closes"
          % args.mode)
    print("  windows you move by hand stay put until the next open or close")
    return 0


def cmd_uninstall_arrange(args):
    sh(["launchctl", "unload", ARRANGE_PLIST])
    if os.path.exists(ARRANGE_PLIST):
        os.remove(ARRANGE_PLIST)
    print("auto-arrange removed")
    return 0


def cmd_uninstall_auto(args):
    sh(["launchctl", "unload", PLIST])
    if os.path.exists(PLIST):
        os.remove(PLIST)
    print("auto-save removed")
    return 0


def rect_arg(s):
    v = [int(x) for x in s.split(",")]
    if len(v) != 4:
        raise argparse.ArgumentTypeError("expected left,top,right,bottom")
    return v


def main():
    p = argparse.ArgumentParser(prog="codex-sessions", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("save", help="snapshot the open windows")
    s.add_argument("--replace", action="store_true",
                   help="record only what is open now, forgetting everything else")
    s.add_argument("--keep-hours", type=int, default=DEFAULT_KEEP_HOURS,
                   help="how long to remember a window that is no longer open (default %d)" % DEFAULT_KEEP_HOURS)
    s.set_defaults(fn=cmd_save)

    s = sub.add_parser("list", help="show the snapshot")
    s.add_argument("--history", action="store_true")
    s.add_argument("--source")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("restore", help="reopen the windows that are missing")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--tabs", action="store_true", help="reopen as tabs in one window")
    s.add_argument("--layout", choices=["saved", "grid", "cascade", "none"], default="saved")
    s.add_argument("--cols", type=int)
    s.add_argument("--rect", type=rect_arg, help="left,top,right,bottom to lay out inside")
    s.add_argument("--force", action="store_true", help="reopen even what is already open")
    s.add_argument("--pace", type=float, default=0.5, help="seconds between windows")
    s.add_argument("--source", help="snapshot file, or an index from `list --history`")
    s.add_argument("--include-archived", action="store_true",
                   help="also reopen conversations you archived")
    s.set_defaults(fn=cmd_restore)

    s = sub.add_parser("arrange", help="retile the windows that are open now")
    s.add_argument("mode", nargs="?", choices=["grid", "cascade", "saved"], default="grid")
    s.add_argument("--cols", type=int)
    s.add_argument("--rect", type=rect_arg)
    s.add_argument("--busy-first", action="store_true",
                   help="put the sessions that are working right now in the first cells")
    s.add_argument("--watch", action="store_true",
                   help="keep running, re-tiling when a window opens or closes")
    s.add_argument("--every", type=int, default=10, help="seconds between checks when watching")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_arrange)

    s = sub.add_parser("install-arrange", help="auto-arrange windows as they open and close")
    s.add_argument("mode", nargs="?", choices=["grid", "cascade", "saved"], default="grid")
    s.add_argument("--cols", type=int)
    s.add_argument("--rect", type=rect_arg)
    s.add_argument("--busy-first", action="store_true")
    s.add_argument("--every", type=int, default=10)
    s.set_defaults(fn=cmd_install_arrange)

    s = sub.add_parser("uninstall-arrange")
    s.set_defaults(fn=cmd_uninstall_arrange)

    s = sub.add_parser("page", help="browsable HTML page of every conversation")
    s.add_argument("--out", default=str(codex_root() / "sessions.html"))
    s.add_argument("--days", type=int, default=45)
    s.add_argument("--all", action="store_true", help="every conversation ever, not just recent")
    s.add_argument("--open", action="store_true", help="open it in the browser")
    s.add_argument("--fast", action="store_true",
                   help="skip reading the full conversations (no drill-down)")
    s.set_defaults(fn=cmd_page)

    s = sub.add_parser("archive", help="remember a conversation but stop reopening it")
    s.add_argument("what", nargs="*", help="directory fragment or session id prefix")
    s.add_argument("--gone", action="store_true", help="archive everything not open right now")
    s.add_argument("--undo", action="store_true")
    s.set_defaults(fn=cmd_archive)

    s = sub.add_parser("find", help="find a conversation, open or closed, and jump to it")
    s.add_argument("query", nargs="+")
    s.add_argument("--go", action="store_true",
                   help="bring the top match's window forward, or reopen it if it is closed")
    s.add_argument("--days", type=int, default=90)
    s.add_argument("--all", action="store_true")
    s.add_argument("--limit", type=int, default=8)
    s.set_defaults(fn=cmd_find)

    s = sub.add_parser("doctor", help="show what it can and cannot see")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("install-auto", help="periodic snapshot via launchd")
    s.add_argument("seconds", nargs="?", type=int, default=600)
    s.set_defaults(fn=cmd_install_auto)

    s = sub.add_parser("uninstall-auto")
    s.set_defaults(fn=cmd_uninstall_auto)

    a = p.parse_args()
    if a.cmd in ("save", "list", "restore", "page", "find", "doctor", "archive", "arrange"):
        stats = sync_all()
        if stats["errors"]:
            warn("Some rollouts could not be normalized; run the feed doctor/tests before relying on completeness")
    if not a.cmd:
        p.print_help()
        return 0
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
