<script>
const DATA = __DATA__;
const esc = s => (s||"").replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const short = p => p.replace(new RegExp("^/Users/[^/]+/"), "~/");
const when = t => { const d = new Date(t); return isNaN(d) ? "" :
  d.toLocaleDateString(undefined,{month:"short",day:"numeric"}) + " " +
  d.toLocaleTimeString(undefined,{hour:"2-digit",minute:"2-digit"}); };
const clock = t => { const d = new Date(t); return isNaN(d) ? "" :
  d.toLocaleTimeString(undefined,{hour:"2-digit",minute:"2-digit"}); };
const span = r => {
  const a = new Date(r.started), b = new Date(r.ended);
  const m = Math.round((b - a) / 60000);
  if (!(m > 0)) return "";
  return m < 60 ? m + "m" : Math.floor(m/60) + "h " + (m%60) + "m";
};
for (const r of DATA)
  r._hay = [r.cwd, r.branch, r.first, r.last,
            ...(r.thread || []).map(m => m.m)].join(" ").toLowerCase();

let query = "";
const hl = s => {
  const e = esc(s);
  if (!query) return e;
  const rx = new RegExp("(" + query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "gi");
  return e.replace(rx, "<mark>$1</mark>");
};

function threadHtml(r) {
  if (!r.thread || !r.thread.length)
    return '<div class="msg"><time></time><p style="color:var(--muted)">' +
           'No prompts recorded — regenerate without --fast to include them.</p></div>';
  return r.thread.map(m => {
    const isHit = query && !m.gap && m.m.toLowerCase().includes(query);
    return '<div class="msg' + (m.gap ? " gap" : "") + (isHit ? " hit" : "") + '">' +
           "<time>" + (m.t ? clock(m.t) : "") + "</time><p>" + hl(m.m) + "</p></div>";
  }).join("");
}

function render() {
  query = document.getElementById("q").value.toLowerCase().trim();
  const st = document.getElementById("state").value;
  const gb = document.getElementById("grp").value;
  const rows = DATA.filter(r => (!st || r.state === st) && (!query || r._hay.includes(query)));
  const out = document.getElementById("out");
  document.getElementById("sub").textContent =
    rows.length + " of " + DATA.length + " conversations · click one to read what you asked";
  if (!rows.length) { out.innerHTML = '<div class="empty">Nothing matches.</div>'; return; }
  const groups = new Map();
  for (const r of rows) {
    const k = gb === "cwd" ? short(r.cwd)
            : gb === "day" ? new Date(r.mtime*1000).toDateString() : "";
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k).push(r);
  }
  out.innerHTML = [...groups].map(([k, rs]) => '<section class="grp">' +
    (k ? "<h2>" + esc(k) + "</h2>" : "") +
    rs.map(r => {
      const hitsIn = query && (r.thread || []).some(m => !m.gap && m.m.toLowerCase().includes(query));
      return '<details class="card" data-s="' + r.session.replace(/^codex-/, "") + '"' + (hitsIn ? " open" : "") + '>' +
        "<summary>" +
          '<div class="t">' + (hl(r.first) || "<em>no prompt yet</em>") + "</div>" +
          (r.last && r.last !== r.first
            ? '<div class="l"><b>left off:</b> ' + hl(r.last) + "</div>" : "") +
          '<div class="meta">' +
            '<span class="chip ' + (r.state === "open" ? "open" : r.state === "archived" ? "arch" : "") +
              '">' + r.state + "</span>" +
            (gb === "cwd" ? "" : '<span class="chip">' + esc(short(r.cwd)) + "</span>") +
            (r.branch ? '<span class="chip">' + esc(r.branch) + "</span>" : "") +
            (r.n ? '<span class="chip">' + r.n + " prompts</span>" : "") +
            (span(r) ? '<span class="chip">' + span(r) + "</span>" : "") +
            "<span>" + when(r.ended) + "</span>" +
            '<button class="cmd" data-c="cd ' + esc(r.cwd) +
              " &amp;&amp; codex resume " + r.session.replace(/^codex-/, "") + '">resume ↗</button>' +
          "</div>" +
        "</summary>" +
        '<div class="thread"></div></details>';
    }).join("") + "</section>").join("");
  document.querySelectorAll("details.card[open]").forEach(fill);
}

function fill(d) {
  const box = d.querySelector(".thread");
  if (box.dataset.done) return;
  box.innerHTML = threadHtml(DATA.find(r => r.session === d.dataset.s));
  box.dataset.done = "1";
