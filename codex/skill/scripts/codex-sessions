#!/usr/bin/env python3
"""codex-sessions — snapshot the open Codex windows and reopen them later.

Codex persists local rollout files under ~/.codex/sessions.
This companion normalizes their conversation text into a private transcript feed,
so nothing needs "saving". What is lost on restart is the WINDOW LAYOUT: which
directories were open, which conversation each one was on, and where each window
sat on screen. This records that, and replays it.

    codex-sessions save                 snapshot the open windows (merges, never shrinks)
    codex-sessions save --replace       snapshot exactly what is open right now
    codex-sessions list                 show the snapshot
    codex-sessions list --history       show previous snapshots
    codex-sessions restore              reopen what is missing, in its saved position
    codex-sessions restore --dry-run    print what it would do
    codex-sessions restore --layout grid
    codex-sessions arrange grid         retile the windows that are open now
    codex-sessions doctor               show what it can and cannot see
    codex-sessions install-auto [secs]  periodic snapshot via launchd
    codex-sessions uninstall-auto
"""

import argparse
import collections
import glob
import json
import math
import os
import re
import shlex
import subprocess
import sys
import time
from codex_transcripts import feed_root, sync_all, codex_root, atomic_write

USER_ROOT = os.path.expanduser("~")
STATE = os.environ.get("CODEX_SESSIONS_STATE", str(codex_root() / "session-restore.json"))
HISTDIR = os.environ.get("CODEX_SESSIONS_HISTORY", str(codex_root() / "session-restore.d"))
PROJ = str(feed_root() / "projects")
PLIST = os.path.join(USER_ROOT, "Library", "LaunchAgents", "dev.codexsessions.snapshot.plist")
KEEP_HISTORY = 30
DEFAULT_KEEP_HOURS = 72

WARNINGS = []


def warn(msg):
    WARNINGS.append(msg)
    print("warning: " + msg, file=sys.stderr)


def sh(cmd, timeout=15):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)


def osa(script, timeout=30):
    try:
        p = subprocess.run(["osascript", "-"], input=script, capture_output=True,
                           text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as e:
        return 1, "", str(e)


def app_running(name):
    rc, out, _ = osa('tell application "System Events" to return (name of processes) contains "%s"' % name)
    return rc == 0 and out.strip() == "true"


# ---------------------------------------------------------------- discovery

def parse_etime(s):
    """[[dd-]hh:]mm:ss  ->  seconds. Locale-independent, unlike lstart."""
    s = s.strip()
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d)
    parts = [int(x) for x in s.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts[-3], parts[-2], parts[-1]
    return days * 86400 + h * 3600 + m * 60 + sec


HEADLESS = re.compile(r'(?!)')  # Codex -p selects a profile, not headless mode.


def is_codex_cli(cmd):
    """Codex terminal clients only, excluding exec, app-server and MCP jobs."""
    try:
        argv = shlex.split(cmd)
    except ValueError:
        return False
    if not argv or os.path.basename(argv[0]) not in ("codex", "codex-tui"):
        return False
    return not any(a in ("exec", "e", "app-server", "mcp-server", "review") for a in argv[1:])


def discover():
    """Every interactive Codex window: pid, ppid, cwd, tty, start time, resumed id."""
    rc, out, _ = sh(["ps", "-axo", "pid=,ppid=,etime=,tty=,command="])
    if rc != 0:
        warn("ps failed; cannot see any windows")
        return []
    now = time.time()
    cand = {}
    for line in out.splitlines():
        m = re.match(r'\s*(\d+)\s+(\d+)\s+(\S+)\s+(\S+)\s+(.*)$', line)
        if not m:
            continue
        pid, ppid, etime, tty, cmd = int(m.group(1)), int(m.group(2)), m.group(3), m.group(4), m.group(5)
        if not is_codex_cli(cmd):
            continue
        if HEADLESS.search(cmd):
            continue          # `claude -p ...` from a hook, not a window
        if tty in ("??", "?", "-"):
            continue          # no terminal => not a window
        cand[pid] = {"pid": pid, "ppid": ppid, "tty": "/dev/" + tty,
                     "start": now - parse_etime(etime), "cmd": cmd}
    # a Claude window forks helper `claude` children that inherit its cwd and tty;
    # keep only the topmost of each family, or the count per directory doubles.
    wins = [w for w in cand.values() if w["ppid"] not in cand]
    for w in wins:
        rm = re.search(r'(?:^|\s)resume\s+([0-9a-fA-F-]{36})(?:\s|$)', w["cmd"])
        w["resumed"] = "codex-" + rm.group(1).lower() if rm else None
        w["cwd"] = pid_cwd(w["pid"])
        if not w["cwd"]:
            warn("could not read the working directory of pid %d (%s) — it will be missing "
                 "from the snapshot" % (w["pid"], w["cmd"][:60]))
    return [w for w in wins if w["cwd"]]


def pid_cwd(pid, tries=3):
    for i in range(tries):
        rc, out, _ = sh(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], timeout=20)
        for line in out.splitlines():
            if line.startswith("n"):
                return line[1:].strip()
        time.sleep(0.2 * (i + 1))
    return None


# ---------------------------------------------------------------- geometry

GEOM_AS = '''
tell application "%s"
  set out to ""
  repeat with w in windows
    try
      set b to bounds of w
      repeat with t in tabs of w
        repeat with s in sessions of t
          set out to out & (tty of s) & "\t" & (item 1 of b) & "\t" & (item 2 of b) & "\t" & (item 3 of b) & "\t" & (item 4 of b) & linefeed
        end repeat
      end repeat
    end try
  end repeat
  return out
end tell
'''

GEOM_TERMINAL = '''
tell application "Terminal"
  set out to ""
  repeat with w in windows
    try
      set b to bounds of w
      repeat with t in tabs of w
        set out to out & (tty of t) & "\t" & (item 1 of b) & "\t" & (item 2 of b) & "\t" & (item 3 of b) & "\t" & (item 4 of b) & linefeed
      end repeat
    end try
  end repeat
  return out
end tell
'''


def terminal_app():
    if app_running("iTerm2"):
        return "iTerm2"
    if app_running("Terminal"):
        return "Terminal"
    return None


def geometry():
    """tty -> {'term': app, 'bounds': [l, t, r, b]}"""
    g = {}
    for app, script in (("iTerm2", GEOM_AS % "iTerm2"), ("Terminal", GEOM_TERMINAL)):
        if not app_running(app):
            continue
        rc, out, err = osa(script)
        if rc != 0:
            warn("could not read %s window positions (%s)" % (app, err[:80]))
            continue
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) == 5:
                try:
                    g[f[0].strip()] = {"term": app, "bounds": [int(x) for x in f[1:]]}
                except ValueError:
                    pass
    return g


# ---------------------------------------------------------------- transcripts

def enc(path):
    return re.sub(r'[/.]', '-', path)


def project_dir(cwd):
    d = os.path.join(PROJ, enc(cwd))
    return d if os.path.isdir(d) else None


def head(path, lines=40, cap=262144):
    """First few records of a transcript, cheaply."""
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            read = 0
            for i, line in enumerate(fh):
                if i >= lines or read > cap:
                    break
                read += len(line)
                try:
                    out.append(json.loads(line))
                except Exception:
                    pass
    except OSError:
        pass
    return out


def entrypoint(path):
    """'cli' for a real window; 'sdk-cli'/'sdk-py' for hook and script runs."""
    for d in head(path, lines=30):
        if "entrypoint" in d:
            return d["entrypoint"]
    return None


def transcripts(cwd, interactive_only=True):
    d = project_dir(cwd)
    if not d:
        return []
    out = []
    for f in glob.glob(os.path.join(d, "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if interactive_only and entrypoint(f) not in (None, "cli"):
            continue      # a hook's headless run, not a window
        out.append({"file": f, "id": os.path.basename(f)[:-6],
                    "born": getattr(st, "st_birthtime", st.st_ctime), "mtime": st.st_mtime})
    return out


def title(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if d.get("type") != "user" or d.get("isSidechain"):
                    continue
                c = d.get("message", {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if isinstance(c, str) and c.strip() and not c.startswith("<"):
                    return " ".join(c.split())[:90]
    except Exception:
        pass
    return ""


def match_sessions(windows):
    """Only exact UUID or open-rollout matches; never guess from mtimes."""
    for w in windows:
        sid = w.get("resumed")
        if not sid:
            rc, out, _ = sh(["lsof", "-a", "-p", str(w["pid"]), "-Fn"])
            matches = set(re.findall(r"rollout-[^\n]*?([0-9a-fA-F]{8}-[0-9a-fA-F-]{27})\.jsonl", out)) if rc == 0 else set()
            if len(matches) == 1:
                sid = "codex-" + next(iter(matches)).lower()
        path = os.path.join(PROJ, enc(w["cwd"]), (sid or "") + ".jsonl")
        w["session"] = sid if sid and os.path.isfile(path) else None
        w["match"] = "resume" if w["session"] else "fresh"
    return windows


# ---------------------------------------------------------------- snapshot io

def load(path=STATE):
    if not os.path.exists(path):
        return None
    try:
        with open(path) as fh:
            d = json.load(fh)
    except Exception as e:
        warn("snapshot at %s is unreadable (%s)" % (path, e))
        return None
    d.setdefault("saved", [])
    return d


def write_snapshot(rows, path=STATE):
    doc = {"version": 2, "saved_at": int(time.time()), "saved": rows}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    atomic_write(path, json.dumps(doc, indent=2))
    if path == STATE:
        os.makedirs(HISTDIR, exist_ok=True)
        hp = os.path.join(HISTDIR, "%d.json" % doc["saved_at"])
        atomic_write(hp, json.dumps(doc, indent=2))
        old = sorted(glob.glob(os.path.join(HISTDIR, "*.json")))[:-KEEP_HISTORY]
        for f in old:
            try:
                os.remove(f)
            except OSError:
                pass
    return doc


def history():
    return sorted(glob.glob(os.path.join(HISTDIR, "*.json")), reverse=True)


# ---------------------------------------------------------------- commands

def cmd_save(args):
    wins = match_sessions(discover())
    if not wins and not args.replace:
        print("no running Codex terminal windows — leaving the existing snapshot alone")
        return 0
    geo = geometry()
    now = int(time.time())
    rows = []
    for w in wins:
        g = geo.get(w["tty"], {})
        f = os.path.join(PROJ, enc(w["cwd"]), (w["session"] or "") + ".jsonl")
        rows.append({
            "cwd": w["cwd"],
            "session": w["session"],
            "title": title(f) if w["session"] and os.path.exists(f) else "",
            "match": w["match"],
            "tty": w["tty"],
            "term": g.get("term"),
            "bounds": g.get("bounds"),
            "last_seen": now,
            "live": True,
        })

    kept = 0
    if not args.replace:
        prev = load()
        have = {r["session"] for r in rows if r["session"]}
        cutoff = now - args.keep_hours * 3600
        for r in (prev or {}).get("saved", []):
            sid = r.get("session")
            if not sid or sid in have:
                continue
            if r.get("last_seen", 0) < cutoff:
                continue
            if not os.path.exists(os.path.join(PROJ, enc(r["cwd"]), sid + ".jsonl")):
                continue
            r = dict(r)
            r["live"] = False
            rows.append(r)
            kept += 1

    rows.sort(key=lambda r: (not r.get("live"), -(r.get("last_seen") or 0)))
    write_snapshot(rows)
    exact = sum(1 for r in rows if r.get("match") in ("resume", "start"))
    guess = sum(1 for r in rows if r.get("match") == "mtime")
    fresh = sum(1 for r in rows if r.get("match") == "fresh")
    bits = ["%d exactly identified" % exact]
    if guess:
        bits.append("%d by best guess" % guess)
    if fresh:
        bits.append("%d with no conversation yet" % fresh)
    print("saved %d window(s) -> %s" % (len(rows), STATE))
    print("  %d open now (%s)%s"
          % (len(wins), ", ".join(bits),
             ", %d remembered from a previous snapshot" % kept if kept else ""))
    if not geo:
        print("  (no window positions captured — is iTerm2 or Terminal running?)")
    return 0


def cmd_list(args):
    if args.history:
        h = history()
        if not h:
            print("no snapshot history yet")
            return 1
        print("%d snapshot(s), newest first:" % len(h))
        for i, f in enumerate(h):
            d = load(f) or {"saved": []}
            ts = time.strftime("%Y-%m-%d %H:%M", time.localtime(d.get("saved_at", 0)))
            live = sum(1 for r in d["saved"] if r.get("live"))
            print("  [%d] %s  %d window(s) (%d open at the time)  %s"
                  % (i, ts, len(d["saved"]), live, os.path.basename(f)))
        return 0
    d = load(args.source or STATE)
    if not d:
        print("no snapshot yet — run: codex-sessions save")
        return 1
    rows = d["saved"]
    ts = time.strftime("%Y-%m-%d %H:%M", time.localtime(d.get("saved_at", 0)))
    print("%d window(s), snapshot taken %s:" % (len(rows), ts))
    running = {(w["cwd"], w.get("session")) for w in match_sessions(discover())}
    for r in rows:
        flags = []
        if (r["cwd"], r.get("session")) in running:
            flags.append("open now")
        elif not r.get("live"):
            flags.append("remembered")
        if r.get("match") == "mtime":
            flags.append("id is a guess")
        if not r.get("bounds"):
            flags.append("no position")
        print("  %s%s" % (r["cwd"], "   [" + ", ".join(flags) + "]" if flags else ""))
        print("     %s  %s" % ((r.get("session") or "-")[:8], (r.get("title") or "")[:72]))
    return 0


def build_cmd(r):
    import uuid
    command = "cd %s && codex" % shlex.quote(r["cwd"])
    if r.get("session"):
        sid = str(uuid.UUID(r["session"].removeprefix("codex-")))
        command += " resume " + shlex.quote(sid)
    return command


def layout_rects(rows, mode, cols=None, rect=None):
    """Return a bounds list, one per row, or None to leave a window where it lands."""
    n = len(rows)
    if n == 0:
        return []
    if mode == "saved":
        return [r.get("bounds") for r in rows]
    if mode == "none":
        return [None] * n
    if rect is None:
        boxes = [r.get("bounds") for r in rows if r.get("bounds")]
        if boxes:
            rect = [min(b[0] for b in boxes), min(b[1] for b in boxes),
                    max(b[2] for b in boxes), max(b[3] for b in boxes)]
        else:
            rc, out, _ = osa('tell application "Finder" to get bounds of window of desktop')
            try:
                rect = [int(x) for x in out.split(",")]
            except Exception:
                rect = [0, 0, 1440, 900]
    l, t, r_, b = rect
    if mode == "cascade":
        w, h = int((r_ - l) * 0.55), int((b - t) * 0.6)
        step = 34
        return [[l + (i * step) % max(1, (r_ - l - w)),
                 t + (i * step) % max(1, (b - t - h)),
                 l + (i * step) % max(1, (r_ - l - w)) + w,
                 t + (i * step) % max(1, (b - t - h)) + h] for i in range(n)]
    c = cols or max(1, math.ceil(math.sqrt(n)))
    rws = max(1, math.ceil(n / c))
    cw, ch = (r_ - l) // c, (b - t) // rws
    gap = 4
    out = []
    for i in range(n):
        cx, cy = i % c, i // c
        out.append([l + cx * cw + gap, t + cy * ch + gap,
                    l + (cx + 1) * cw - gap, t + (cy + 1) * ch - gap])
    return out


NEW_WINDOW_ITERM = '''
tell application "iTerm2"
  set w to (create window with default profile)
  tell current session of w to write text %s
  %s
  return tty of current session of w
end tell
'''

NEW_TAB_ITERM = '''
tell application "iTerm2"
  tell current window
    set s to (create tab with default profile)
    tell current session of s to write text %s
  end tell
  return "tab"
end tell
'''

NEW_WINDOW_TERMINAL = '''
tell application "Terminal"
  set t to do script %s
  set w to first window whose tabs contains t
  %s
  return tty of t
end tell
'''


def as_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def open_window(term, command, bounds, tabs=False):
    setb = ""
    if bounds:
        # A window that was just created is still being placed by the terminal, so a
        # single `set bounds` gets the size but not the origin. Let it settle, then
        # apply twice — the second one sticks.
        b = "set bounds of w to {%d, %d, %d, %d}" % tuple(bounds)
        setb = "delay 0.25\n  %s\n  delay 0.15\n  %s" % (b, b)
    if term == "iTerm2":
        script = NEW_TAB_ITERM % as_str(command) if tabs else NEW_WINDOW_ITERM % (as_str(command), setb)
    else:
        setb = setb.replace("of w", "of w")
        script = NEW_WINDOW_TERMINAL % (as_str(command), setb)
    for attempt in range(3):
        rc, out, err = osa(script, timeout=45)
        if rc == 0 and out:
            return True, out
        time.sleep(0.6 * (attempt + 1))
    return False, err


def cmd_restore(args):
    src = args.source
    if src and src.isdigit():
        h = history()
        i = int(src)
        if i >= len(h):
            print("no snapshot [%s] in history" % src)
            return 1
        src = h[i]
    d = load(src or STATE)
    if not d:
        print("no snapshot — run: codex-sessions save")
        return 1
    # a window with no conversation yet still deserves to come back, as an empty one
    rows = [r for r in d["saved"] if r.get("cwd")]
    archived = [r for r in rows if r.get("archived")]
    if archived and not args.include_archived:
        rows = [r for r in rows if not r.get("archived")]

    running = {(w["cwd"], w.get("session")) for w in match_sessions(discover())}
    skipped = [r for r in rows if (r["cwd"], r["session"]) in running]
    if not args.force:
        rows = [r for r in rows if (r["cwd"], r["session"]) not in running]

    if not rows:
        print("nothing to reopen — all %d window(s) in the snapshot are already open%s"
              % (len(skipped),
                 " (%d archived, --include-archived to reopen those)" % len(archived)
                 if archived else ""))
        return 0
    if archived and not args.include_archived:
        print("(%d archived window(s) left closed — see `codex-sessions page`)" % len(archived))

    rects = layout_rects(rows, args.layout, cols=args.cols, rect=args.rect)

    if args.dry_run:
        print("would reopen %d window(s)%s:"
              % (len(rows), " (%d already open, skipped)" % len(skipped) if skipped else ""))
        for r, bb in zip(rows, rects):
            print("  %s%s" % (build_cmd(r), ("   @ %s" % bb) if bb else ""))
        return 0

    term = terminal_app()
    if not term:
        print("neither iTerm2 nor Terminal is running — start one first")
        return 1
    print("reopening %d window(s) via %s%s ..."
          % (len(rows), term, " (%d already open, skipped)" % len(skipped) if skipped else ""))

    ok, failed = 0, []
    for i, (r, bb) in enumerate(zip(rows, rects)):
        good, out = open_window(term, build_cmd(r), bb, tabs=args.tabs and i > 0)
        if good:
            ok += 1
        else:
            failed.append((r, out))
        time.sleep(args.pace)

    print("reopened %d of %d window(s)" % (ok, len(rows)))
    if failed:
        print("FAILED to reopen %d — rerun to retry just these:" % len(failed))
        for r, err in failed:
            print("  %s" % build_cmd(r))
            if err:
                print("      %s" % err[:120])
        return 1
    return 0


MOVE_ITERM = """
tell application "iTerm2"
  repeat with w in windows
    try
      if (tty of first session of first tab of w) is "%s" then
        set bounds of w to {%d, %d, %d, %d}
        delay 0.15
        set bounds of w to {%d, %d, %d, %d}
        return "ok"
      end if
    end try
  end repeat
  return ""
end tell
"""

MOVE_TERMINAL = """
tell application "Terminal"
  repeat with w in windows
    try
      if (tty of first tab of w) is "%s" then
        set bounds of w to {%d, %d, %d, %d}
        delay 0.15
        set bounds of w to {%d, %d, %d, %d}
        return "ok"
      end if
    end try
  end repeat
  return ""
end tell
"""


def move_script(app, tty, bounds):
    tmpl = MOVE_ITERM if app == "iTerm2" else MOVE_TERMINAL
    return tmpl % ((tty,) + tuple(bounds) + tuple(bounds))


def cmd_arrange(args):
    if getattr(args, "watch", False):
        return arrange_watch(args)
    return arrange_once(args)


def arrange_watch(args):
    """Re-tile whenever a Claude window opens or closes — and only then, so that a
    window you drag somewhere on purpose is left where you put it."""
    print("watching for windows opening and closing (every %ds); ctrl-c to stop" % args.every)
    last = None
    while True:
        sig = tuple(sorted(w["tty"] for w in discover()))
        if sig != last:
            if sig:
                arrange_once(args)
            last = sig
        try:
            time.sleep(args.every)
        except KeyboardInterrupt:
            return 0


def arrange_once(args):
    wins = match_sessions(discover())
    if not wins:
        print("no running Codex terminal windows")
        return 0
    geo = geometry()
    term = terminal_app()
    if not term:
        print("neither iTerm2 nor Terminal is running")
        return 1

    if args.mode == "saved":
        d = load()
        if not d:
            print("no snapshot to take positions from")
            return 1
        pos = {r["session"]: r.get("bounds") for r in d["saved"] if r.get("bounds")}
        rows = [{"bounds": pos.get(w.get("session"))} for w in wins]
        rects = [r["bounds"] for r in rows]
    else:
        for w in wins:
            w["bounds"] = geo.get(w["tty"], {}).get("bounds")
        if args.busy_first:
            # a session being written to right now is one you are waiting on, so give
            # it the first cell of the grid
            def activity(w):
                f = os.path.join(PROJ, enc(w["cwd"]), (w.get("session") or "") + ".jsonl")
                try:
                    return -os.path.getmtime(f)
                except OSError:
                    return 0
            wins.sort(key=activity)
        else:
            wins.sort(key=lambda w: (w["cwd"], w.get("session") or ""))
        rects = layout_rects(wins, args.mode, cols=args.cols, rect=args.rect)

    moved = 0
    for w, bb in zip(wins, rects):
        if not bb:
            continue
        app = geo.get(w["tty"], {}).get("term", term)
        s = move_script(app, w["tty"], bb)
        if args.dry_run:
            print("  %s  ->  %s" % (w["cwd"], bb))
            moved += 1
            continue
        rc, out, err = osa(s)
        if rc == 0 and out == "ok":
            moved += 1
        else:
            warn("could not move the window for %s (%s)"
                 % (w["cwd"], (err or "no terminal window on " + w["tty"])[:80]))
    print("%s %d of %d window(s) [%s]"
          % ("would arrange" if args.dry_run else "arranged", moved, len(wins), args.mode))
    return 0


# ---------------------------------------------------------------- library

def tail_user(path, window=196608):
    """The last thing you actually said in a conversation — 'where I left off'."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            fh.seek(max(0, size - window))
            chunk = fh.read().decode("utf-8", "replace")
    except OSError:
        return "", None
    lines = chunk.splitlines()
    if size > window and lines:
        lines = lines[1:]                       # first line is probably cut in half
    last_ts = None
    text = ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if last_ts is None and d.get("timestamp"):
            last_ts = d["timestamp"]
        if text or d.get("type") != "user" or d.get("isSidechain"):
            continue
        c = d.get("message", {}).get("content")
        if isinstance(c, list):
            c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
        if isinstance(c, str) and c.strip() and not c.startswith("<"):
            text = " ".join(c.split())[:280]
    return text, last_ts


USER_HINT = b'"type":"user"'


def thread(path, cap=80, chars=260):
    """Every prompt you typed in a conversation — the thing worth drilling into.

    The transcripts run to tens of megabytes, so only lines that could possibly
    be a user message are handed to the JSON parser.
    """
    msgs = []
    try:
        with open(path, "rb") as fh:
            for raw in fh:
                if USER_HINT not in raw:
                    continue
                try:
                    d = json.loads(raw.decode("utf-8", "replace"))
                except Exception:
                    continue
                if d.get("type") != "user" or d.get("isSidechain"):
                    continue
                c = d.get("message", {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if not isinstance(c, str):
                    continue
                c = " ".join(c.split())
                if not c or c.startswith("<") or c.startswith("Base directory for this skill:"):
                    continue          # tool results and skill preambles, not you talking
                msgs.append({"t": d.get("timestamp"), "m": c[:chars]})
    except OSError:
        pass
    if len(msgs) > cap:
        head_n = cap // 2
        elided = len(msgs) - cap
        msgs = (msgs[:head_n]
                + [{"t": None, "m": "… %d more prompts …" % elided, "gap": True}]
                + msgs[-(cap - head_n):])
    return msgs


def scan_library(days=None, deep=False):
    """Every real conversation on disk, newest first, with enough to recognise it."""
    cutoff = time.time() - days * 86400 if days else 0
    rows = []
    for f in glob.glob(os.path.join(PROJ, "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < cutoff or st.st_size == 0:
            continue
        recs = head(f)
        ep = next((d["entrypoint"] for d in recs if "entrypoint" in d), None)
        if ep not in (None, "cli", "app"):
            continue
        cwd = next((d["cwd"] for d in recs if d.get("cwd")), None)
        if not cwd:
            continue
        branch = next((d.get("gitBranch") for d in recs if d.get("gitBranch")), "")
        started = next((d["timestamp"] for d in recs if d.get("timestamp")), None)
        first = ""
        for d in recs:
            if d.get("type") == "user" and not d.get("isSidechain"):
                c = d.get("message", {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict))
                if isinstance(c, str) and c.strip() and not c.startswith("<"):
                    first = " ".join(c.split())[:200]
                    break
        if not first:
            first = title(f)[:200]
        last, last_ts = tail_user(f)
        row = {"cwd": cwd, "branch": branch or "", "session": os.path.basename(f)[:-6],
               "first": first, "last": last, "started": started,
               "ended": last_ts or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(st.st_mtime)),
               "mtime": int(st.st_mtime), "bytes": st.st_size}
        if deep:
            row["thread"] = thread(f)
            row["n"] = sum(1 for m in row["thread"] if not m.get("gap"))
            if row["thread"]:
                row["first"] = row["thread"][0]["m"][:200] or row["first"]
                row["last"] = row["thread"][-1]["m"][:280]
        rows.append(row)
    rows.sort(key=lambda r: -r["mtime"])
    return rows


